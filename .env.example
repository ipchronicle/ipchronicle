# Host port published by Docker Compose.
IPCHRONICLE_HTTP_PORT=8080

# Bootstrap inputs used only when config.db has no administrator account.
IPCHRONICLE_ADMIN_USERNAME=admin
IPCHRONICLE_ADMIN_PASSWORD=admin

# Optional comma-separated CIDRs of reverse proxies allowed to supply
# X-Forwarded-For and X-Forwarded-Proto.
IPCHRONICLE_TRUSTED_PROXIES=
