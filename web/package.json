{
  "name": "@ipchronicle/web",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=11.16.0 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-typescript ../openapi/openapi.yaml -o src/api/schema.d.ts",
    "lint": "oxlint --deny-warnings",
    "openapi:lint": "redocly lint ../openapi/openapi.yaml --config ../openapi/redocly.yaml",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "preflight": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run openapi:lint",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run openapi:lint && npm run build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "html-to-image": "1.11.13",
    "i18next": "26.3.6",
    "lucide-react": "1.29.0",
    "openapi-fetch": "0.17.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router": "8.3.0",
    "semver": "7.8.5",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.45.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.77.0",
    "prettier": "3.9.6",
    "shadcn": "4.16.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
