package nodes

import (
	"context"
	"database/sql"
	"encoding/json"
	"os"
	"path/filepath"
	"reflect"
	"sort"
	"strings"
	"testing"

	"github.com/ipchronicle/ipchronicle/internal/center/admin"
	"github.com/ipchronicle/ipchronicle/internal/center/database"
)

type upgradeTable struct {
	Columns []string
	Rows    []string
}

type upgradeCenter struct {
	Registration Registration
	Key          [32]byte
	Config       map[string]upgradeTable
	History      map[string]upgradeTable
}

func TestStableCenterUpgrade(t *testing.T) {
	directory := os.Getenv("UPGRADE_FIXTURE_DIRECTORY")
	if directory == "" {
		t.Fatal("UPGRADE_FIXTURE_DIRECTORY is required")
	}
	paths := database.PathsFromDataDirectory(filepath.Join(directory, "center"))
	manifest := filepath.Join(directory, "center.json")
	if os.Getenv("UPGRADE_FIXTURE_MODE") == "seed" {
		fixture := newProbeServiceFixture(t, 512*1024*1024)
		account := admin.NewService(fixture.store.Config, fixture.store.ConfigQueries, fixture.store.MasterKey)
		if err := account.Bootstrap(fixture.ctx, "upgrade-admin", "synthetic-upgrade-admin-password"); err != nil {
			t.Fatal(err)
		}
		password := "synthetic-upgrade-proxy-password"
		if _, err := fixture.service.CreateNetworkProxy(fixture.ctx, fixture.registration.NodeID, NetworkProxyCreate{
			Name: "upgrade-proxy", Scheme: "socks5", Host: "proxy.example.test", Port: 1080, Password: &password,
		}); err != nil {
			t.Fatal(err)
		}
		seedRetentionSnapshot(t, fixture, fixture.egresses[0].ID.String(), 1, fixture.now, 128)
		expected := upgradeCenter{Registration: fixture.registration, Key: fixture.store.MasterKey,
			Config: upgradeTables(t, fixture.store.Config, nil), History: upgradeTables(t, fixture.store.History, nil)}
		for _, path := range []string{paths.ConfigDatabase, paths.HistoryDatabase} {
			if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
				t.Fatal(err)
			}
		}
		if _, err := fixture.store.Config.Exec("VACUUM INTO ?", paths.ConfigDatabase); err != nil {
			t.Fatal(err)
		}
		if _, err := fixture.store.History.Exec("VACUUM INTO ?", paths.HistoryDatabase); err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(paths.MasterKey, expected.Key[:], 0600); err != nil {
			t.Fatal(err)
		}
		body, err := json.Marshal(expected)
		if err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(manifest, body, 0600); err != nil {
			t.Fatal(err)
		}
		return
	}
	var expected upgradeCenter
	body, err := os.ReadFile(manifest)
	if err != nil {
		t.Fatal(err)
	}
	if err := json.Unmarshal(body, &expected); err != nil {
		t.Fatal(err)
	}
	store, err := database.Open(context.Background(), paths)
	if err != nil {
		t.Fatal(err)
	}
	defer store.Close()
	if store.MasterKey != expected.Key {
		t.Fatal("Center master key changed")
	}
	if !reflect.DeepEqual(upgradeTables(t, store.Config, expected.Config), expected.Config) {
		t.Fatal("existing configuration rows changed during upgrade")
	}
	if !reflect.DeepEqual(upgradeTables(t, store.History, expected.History), expected.History) {
		t.Fatal("existing history rows changed during upgrade")
	}
	service := NewService(store.Config, store.History, store.ConfigQueries, store.MasterKey, &testSyncConnections{})
	account := admin.NewService(store.Config, store.ConfigQueries, store.MasterKey)
	if _, _, err := account.Login(context.Background(), "upgrade-admin", "synthetic-upgrade-admin-password", "", "127.0.0.1", "upgrade-test"); err != nil {
		t.Fatal("retained administrator cannot log in", err)
	}
	configuration, err := service.Configuration(context.Background(), expected.Registration.Credential)
	if err != nil {
		t.Fatal(err)
	}
	if len(configuration.Proxies) != 1 || configuration.Proxies[0].Password == nil ||
		*configuration.Proxies[0].Password != "synthetic-upgrade-proxy-password" {
		t.Fatal("retained Agent credential or encrypted proxy configuration is unreadable")
	}
}

func upgradeTables(t *testing.T, db *sql.DB, baseline map[string]upgradeTable) map[string]upgradeTable {
	t.Helper()
	if baseline == nil {
		baseline = make(map[string]upgradeTable)
		rows, err := db.Query("SELECT name FROM sqlite_schema WHERE type = 'table' AND name NOT LIKE 'sqlite_%' AND name != 'goose_db_version'")
		if err != nil {
			t.Fatal(err)
		}
		for rows.Next() {
			var name string
			if err := rows.Scan(&name); err != nil {
				t.Fatal(err)
			}
			baseline[name] = upgradeTable{}
		}
		if err := rows.Err(); err != nil {
			t.Fatal(err)
		}
		if err := rows.Close(); err != nil {
			t.Fatal(err)
		}
	}
	quote := func(name string) string { return `"` + strings.ReplaceAll(name, `"`, `""`) + `"` }
	result := make(map[string]upgradeTable)
	for name, table := range baseline {
		projection := "*"
		if len(table.Columns) > 0 {
			columns := make([]string, len(table.Columns))
			for i, column := range table.Columns {
				columns[i] = quote(column)
			}
			projection = strings.Join(columns, ",")
		}
		rows, err := db.Query("SELECT " + projection + " FROM " + quote(name))
		if err != nil {
			t.Fatal(err)
		}
		columns, err := rows.Columns()
		if err != nil {
			t.Fatal(err)
		}
		actual := upgradeTable{Columns: columns}
		for rows.Next() {
			values := make([]any, len(columns))
			pointers := make([]any, len(columns))
			for i := range values {
				pointers[i] = &values[i]
			}
			if err := rows.Scan(pointers...); err != nil {
				t.Fatal(err)
			}
			body, err := json.Marshal(values)
			if err != nil {
				t.Fatal(err)
			}
			actual.Rows = append(actual.Rows, string(body))
		}
		if err := rows.Err(); err != nil {
			t.Fatal(err)
		}
		if err := rows.Close(); err != nil {
			t.Fatal(err)
		}
		sort.Strings(actual.Rows)
		result[name] = actual
	}
	return result
}
